# Copy this file to .env.local and fill in real values (never commit .env.local)

# From Supabase: Project Settings > API > Project URL
SUPABASE_URL=

# From Supabase: Project Settings > API > service_role secret key
# WARNING: this key bypasses all security rules. Server-side use only. Never expose it in frontend code.
SUPABASE_SERVICE_KEY=

# A password only YOU know, used to log into /admin and to run the generate script
ADMIN_PASSWORD=

# The live URL your QR codes will redirect through, e.g. https://scanmy.biz or https://your-project.vercel.app
NEXT_PUBLIC_BASE_URL=
